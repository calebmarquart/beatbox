{
  // Let clangd ask the ARM cross-compiler (used in build/Debug/compile_commands.json)
  // for its standard-library include paths; without this <array>, <cmath>, ... aren't found.
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": ["--query-driver=/usr/bin/arm-none-eabi-*"]
      }
    }
  }
}
